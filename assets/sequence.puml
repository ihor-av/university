@startuml
skinparam dpi 150
autonumber

actor "Науковець" as N
participant "Система\n«ЛабЖурнал»" as S
participant "Зовнішній\nAI-сервіс" as AI

N -> S : обрати задачу дослідження,\n«Створити протокол»
S --> N : показати затверджені шаблони протоколів
N -> S : обрати шаблон, замовити чернетку протоколу
S -> AI : запит на чернетку: задача, шаблон, дані бази знань

alt AI-сервіс доступний
  AI --> S : чернетка протоколу
  S --> N : показати чернетку протоколу
else AI-сервіс недоступний (резервний режим)
  S --> N : порожній протокол за шаблоном, повідомлення про режим
end

N -> S : відредагувати, затвердити протокол
S --> N : протокол збережено (версія 1, статус «Погоджено»)
note right of S : дія фіксується в журналі дій\n(аудит)
@enduml
